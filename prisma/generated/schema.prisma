enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  isSystem        Boolean          @default(false) @map("is_system")
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  resource        String
  action          String
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String   @map("assigned_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  assignedBy   User     @relation("AssignedByStaff", fields: [assignedById], references: [id])
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user         User     @relation("UserRolesForUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  firstName       String          @map("first_name")
  lastName        String          @map("last_name")
  email           String          @unique
  phone           String
  password        String
  status          UserStatus      @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  addresses       Address[]
  refreshTokens   RefreshToken[]
  approvedSellers SellerProfile[] @relation("ApprovedSellers")
  sellerProfile   SellerProfile?
  assignedRoles   UserRole[]      @relation("AssignedByStaff")
  userRoles       UserRole[]      @relation("UserRolesForUser")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  fullName    String   @map("full_name")
  phone       String
  country     String
  division    String
  district    String
  addressLine String   @map("address_line")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@map("addresses")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @map("token_hash")
  deviceName String   @map("device_name")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model SellerProfile {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @unique @map("user_id") @db.Uuid
  storeName      String       @map("store_name")
  storeSlug      String       @unique @map("store_slug")
  businessEmail  String       @map("business_email")
  businessPhone  String       @map("business_phone")
  commissionRate Decimal      @map("commission_rate") @db.Decimal(5, 2)
  status         SellerStatus @default(PENDING)
  approvedById   String?      @map("approved_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")
  products       Product[]
  approvedBy     User?        @relation("ApprovedSellers", fields: [approvedById], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([approvedById])
  @@index([status])
  @@index([deletedAt])
  @@map("seller_profiles")
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  slug        String     @unique
  description String?
  parentId    String?    @map("parent_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@index([parentId])
  @@index([deletedAt])
  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?   @map("logo_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  products    Product[]

  @@index([deletedAt])
  @@map("brands")
}

model Product {
  id              String           @id @default(uuid()) @db.Uuid
  sellerProfileId String           @map("seller_profile_id") @db.Uuid
  categoryId      String           @map("category_id") @db.Uuid
  brandId         String           @map("brand_id") @db.Uuid
  name            String
  slug            String           @unique
  description     String
  status          ProductStatus    @default(DRAFT)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  variants        ProductVariant[]
  brand           Brand            @relation(fields: [brandId], references: [id])
  category        Category         @relation(fields: [categoryId], references: [id])
  sellerProfile   SellerProfile    @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([sellerProfileId])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([deletedAt])
  @@map("products")
}

model ProductVariant {
  id                String             @id @default(uuid()) @db.Uuid
  productId         String             @map("product_id") @db.Uuid
  sku               String             @unique
  price             Decimal            @db.Decimal(12, 2)
  compareAtPrice    Decimal?           @map("compare_at_price") @db.Decimal(12, 2)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  deletedAt         DateTime?          @map("deleted_at")
  inventory         Inventory?
  images            ProductImage[]
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantAttributes VariantAttribute[]

  @@index([productId])
  @@index([deletedAt])
  @@map("product_variants")
}

model Inventory {
  id               String         @id @default(uuid()) @db.Uuid
  productVariantId String         @unique @map("product_variant_id") @db.Uuid
  stock            Int            @default(0)
  reserved         Int            @default(0)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@map("inventories")
}

model ProductImage {
  id               String         @id @default(uuid()) @db.Uuid
  productVariantId String         @map("product_variant_id") @db.Uuid
  url              String
  isFeatured       Boolean        @default(false) @map("is_featured")
  sortOrder        Int            @default(0) @map("sort_order")
  createdAt        DateTime       @default(now()) @map("created_at")
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([productVariantId])
  @@map("product_images")
}

model Attribute {
  id        String           @id @default(uuid()) @db.Uuid
  name      String           @unique
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  values    AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id                String             @id @default(uuid()) @db.Uuid
  attributeId       String             @map("attribute_id") @db.Uuid
  value             String
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  attribute         Attribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantAttributes VariantAttribute[]

  @@unique([attributeId, value])
  @@index([attributeId])
  @@map("attribute_values")
}

model VariantAttribute {
  id               String         @id @default(uuid()) @db.Uuid
  productVariantId String         @map("product_variant_id") @db.Uuid
  attributeValueId String         @map("attribute_value_id") @db.Uuid
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, attributeValueId])
  @@index([attributeValueId])
  @@map("variant_attributes")
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}
