model User {
  id        String   @id @default(uuid()) @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  phone     String
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  addresses       Address[]
  refreshTokens   RefreshToken[]
  sellerProfile   SellerProfile?
  approvedSellers SellerProfile[] @relation("ApprovedSellers")
  userRoles       UserRole[]      @relation("UserRolesForUser")
  assignedRoles   UserRole[]      @relation("AssignedByStaff")

  @@map("users")
}

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  fullName    String   @map("full_name")
  phone       String
  country     String
  division    String
  district    String
  addressLine String   @map("address_line")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @map("token_hash")
  deviceName String   @map("device_name")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model SellerProfile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  storeName      String   @map("store_name")
  storeSlug      String   @unique @map("store_slug")
  businessEmail  String   @map("business_email")
  businessPhone  String   @map("business_phone")
  commissionRate Decimal  @map("commission_rate") @db.Decimal(5, 2)
  status         String   @default("pending")
  approvedById   String?  @map("approved_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("ApprovedSellers", fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("seller_profiles")
}

model Role {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  isSystem Boolean @default(false) @map("is_system")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  resource String
  action   String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String   @map("assigned_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  user       User @relation("UserRolesForUser", fields: [userId], references: [id], onDelete: Cascade)
  role       Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User @relation("AssignedByStaff", fields: [assignedById], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}
