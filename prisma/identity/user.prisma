model User {
  id        String     @id @default(uuid()) @db.Uuid
  firstName String     @map("first_name")
  lastName  String     @map("last_name")
  email     String     @unique
  phone     String
  password  String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  addresses       Address[]
  refreshTokens   RefreshToken[]
  sellerProfile   SellerProfile?
  approvedSellers SellerProfile[] @relation("ApprovedSellers")
  userRoles       UserRole[]      @relation("UserRolesForUser")
  assignedRoles   UserRole[]      @relation("AssignedByStaff")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  fullName    String   @map("full_name")
  phone       String
  country     String
  division    String
  district    String
  addressLine String   @map("address_line")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@map("addresses")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @map("token_hash")
  deviceName String   @map("device_name")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model SellerProfile {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @unique @map("user_id") @db.Uuid
  storeName      String       @map("store_name")
  storeSlug      String       @unique @map("store_slug")
  businessEmail  String       @map("business_email")
  businessPhone  String       @map("business_phone")
  commissionRate Decimal      @map("commission_rate") @db.Decimal(5, 2)
  status         SellerStatus @default(PENDING)
  approvedById   String?      @map("approved_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User?    @relation("ApprovedSellers", fields: [approvedById], references: [id], onDelete: SetNull)
  products   Product[]

  @@index([approvedById])
  @@index([status])
  @@index([deletedAt])
  @@map("seller_profiles")
}
